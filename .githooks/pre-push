#!/bin/sh
# Git pre-push hook: run verify before pushing to remote
echo "[git pre-push] Running 'npm run verify'..."
npm run verify
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ [git pre-push] Push aborted: 'npm run verify' failed."
  echo "Fix the issues above before pushing."
  echo ""
  exit 1
fi
